# Slack Incoming Webhook
# Get yours: https://api.slack.com/apps → Create App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_WEBHOOK_URL_ERR=https://hooks.slack.com/services/YOUR/ERROR/WEBHOOK/URL

# Alpha Vantage (news sentiment — weekly briefing only)
# Get yours: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY

# Open DART (Korean listed company disclosure)
# Get yours: https://opendart.fss.or.kr → Sign up → Open API → Request API key
DART_API_KEY=YOUR_DART_API_KEY

# KRX (Korea Exchange — pykrx auth)
KRX_ID=YOUR_KRX_ID
KRX_PW=YOUR_KRX_PASSWORD

# Finnhub API (stock prices + exchange rate — optional)
# Get yours: https://finnhub.io
# FINNHUB_API_KEY=YOUR_FINNHUB_KEY
