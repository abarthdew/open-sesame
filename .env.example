# Slack Incoming Webhook
# 발급: https://api.slack.com/apps → Create App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_WEBHOOK_URL_ERR=https://hooks.slack.com/services/YOUR/ERROR/WEBHOOK/URL

# Alpha Vantage (뉴스 감성 분석 — 주간 회고 한정)
# 발급: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY

# Open DART (한국 상장사 공시 정보)
# 발급: https://opendart.fss.or.kr → 회원가입 → Open API → API 키 신청
DART_API_KEY=YOUR_DART_API_KEY

# KRX (한국거래소 — pykrx 인증)
KRX_ID=YOUR_KRX_ID
KRX_PW=YOUR_KRX_PASSWORD

# Finnhub API (종목 시세 + 환율 — 선택)
# 발급: https://finnhub.io
# FINNHUB_API_KEY=YOUR_FINNHUB_KEY
